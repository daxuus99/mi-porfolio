---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";
import SocialLink from "../components/SocialLink.astro";
import Link from "../components/Link.astro";
import { getCollection } from "astro:content";
import { Markdown } from "@astropub/md";
import { aboutPageContent } from "../config";
import ResumeItem from "../components/ResumeItem.astro";
import { techStack } from "../config";
---

<Layout seo={homePageContent.seo}>
  <section class="mt-10 max-w-2xl mx-auto px-6">
    <h1 class="font-bold text-3xl mb-1">{identity.name}</h1>
    <p class="opacity-60 mb-10">{homePageContent.role}</p>
    <div class="flex flex-col min-[520px]:flex-row gap-6 mb-8">
      <Image
        src={identity.logo}
        alt={identity.name}
        width={120}
        height={100}
        class="rounded-full"
      />
      <div class="group flex flex-col justify-center gap-2 w-fit">
        {
          homePageContent.socialLinks.map((link) => (
            <SocialLink
              title={link.title}
              url={link.url}
              icon={link.icon}
              external={link.external}
            />
          ))
        }
      </div>
    </div>
    <p class="max-w-md mb-8">
      {homePageContent.description}
    </p>
    <div class="flex items-center gap-4 group w-fit">
      {
        homePageContent.links.map((link) => (
          <Link text={link.title} href={link.url} external={link.external} />
        ))
      }
    </div>
  </section>
  
  <section class="my-20 mt-12 max-w-2xl mx-auto px-6 sm:flex sm:gap-16">
    <div>
      <h2 class="font-bold text-3xl sm:text-4xl mb-4">Mi tecnologías</h2>
      <p class="mb-10">
        Como desarrollador Frontend, he trabajado con distintos frameworks, herramientas y tecnologías tanto del lado cliente como en bases de datos y control de versiones.
      </p>
  
      <div class="grid md:grid-cols-2 gap-8">
        {techStack.map((category) => (
          <div class="bg-white/80 dark:bg-zinc-900/70 border border-gray-200 dark:border-zinc-700 rounded-2xl shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all backdrop-blur-md p-6 relative overflow-hidden group">
            <div class="absolute inset-0 opacity-10 group-hover:opacity-20 transition-all duration-300 bg-gradient-to-br from-gray-900 via-black-100 to-purple-300 blur-2xl z-0 pointer-events-none"></div>
            <div class="relative z-10">
              <h3 class="text-xl font-bold mb-6 text-primary">{category.title}</h3>
              {category.items.length > 0 ? (
                <div class="flex flex-wrap gap-5 justify-center">
                  {category.items.map((tech) => (
                    <div class="flex flex-col items-center w-20">
                      <div class="w-12 h-12 rounded-full bg-gray-100 dark:bg-zinc-800 flex items-center justify-center shadow-md hover:shadow-lg transition">
                        <img src={tech.icon} alt={tech.name} class="w-6 h-6" />
                      </div>
                      <span class="mt-2 text-sm text-gray-700 dark:text-gray-200">{tech.name}</span>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-sm opacity-60">Próximamente...</p>
              )}
            </div>
          </div>
        ))}
      </div>
      
    </div>
  </section>
  
  <section class="my-20 mt-12 max-w-2xl mx-auto px-6 sm:flex sm:gap-16">
    <div>
      <h2 class="font-bold text-3xl sm:text-4xl mb-4">Mi experiencia</h2>
      <div class="mb-6">
        <Markdown of={aboutPageContent.work.description} />
      </div>
      <div class="grid grid-cols-1 group">
        {aboutPageContent.work.items.map((item) => <ResumeItem {...item} />)}
      </div>
    </div>
  </section>

</Layout>
